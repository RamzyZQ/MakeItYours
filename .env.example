# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Nomor WhatsApp toko (format internasional tanpa +), contoh: 62812xxxxxxx
VITE_WHATSAPP_NUMBER="6281234567890"

# Server-only order storage. Never prefix these with VITE_ or expose them in the browser.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# ID of the order folder in the Google account authorized with OAuth.
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
CRON_SECRET=""
# Admin login and signed HttpOnly session cookie.
ADMIN_PIN="CHANGE_THIS_TO_A_STRONG_INITIAL_PIN"
ADMIN_SESSION_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
